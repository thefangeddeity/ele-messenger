#!/bin/bash
set -e

# Create system user
adduser --system --no-create-home --group ele-messenger 2>/dev/null || true

# Create data directory
mkdir -p /var/lib/ele-messenger
chown ele-messenger:ele-messenger /var/lib/ele-messenger

# nginx: only when nothing serves the messenger yet, give it a block of its
# own on port 80. Other sites' files are never edited, and running this
# again (any upgrade) changes nothing.
if ! grep -rqsE 'ele-messenger(\.conf)?;|location /ele-api/' \
        /etc/nginx/nginx.conf /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null; then
    mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled
    cat > /etc/nginx/sites-available/ele-messenger-standalone << 'NGEOF'
server {
    listen 80;
    include /etc/nginx/sites-available/ele-messenger;
}
NGEOF
    ln -sf /etc/nginx/sites-available/ele-messenger-standalone \
        /etc/nginx/sites-enabled/ele-messenger-standalone
    echo "==> Serving ELE Messenger on port 80 (nginx: sites-enabled/ele-messenger-standalone)."
fi

nginx -t && systemctl reload nginx || echo "==> nginx reload failed; check its config"

# Enable and start service
systemctl daemon-reload
systemctl enable ele-messenger
systemctl restart ele-messenger
echo "==> ELE Messenger server started."
