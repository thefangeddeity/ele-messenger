<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Announces this ELE Messenger server so apps on the network find it
     without DNS or a tailnet. The port is the one nginx serves the
     messenger on: 80 for the block the package creates; change it (and keep
     the change, it's a config file) if this machine serves it elsewhere.
     The TXT records tell clients where the API and websocket live. -->
<service-group>
  <name replace-wildcards="yes">ELE Messenger on %h</name>
  <service>
    <type>_ele-messenger._tcp</type>
    <port>80</port>
    <txt-record>scheme=http</txt-record>
    <txt-record>api=/ele-api</txt-record>
    <txt-record>ws=/ele-ws</txt-record>
  </service>
</service-group>
